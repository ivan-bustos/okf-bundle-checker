{
  "name": "okf-bundle-checker",
  "version": "1.0.0-alpha.2",
  "type": "module",
  "description": "Offline CLI and reusable engine for Open Knowledge Format v0.2 compliance and configurable knowledge-bundle quality checks.",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "bin": {
    "okf-checker": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "assets",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "node scripts/package-smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run smoke",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "smoke:ci": "node scripts/ci-example-smoke.mjs --output reports/ci-examples",
    "prepack": "npm run build"
  },
  "dependencies": {
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivan-bustos/okf-bundle-checker.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/ivan-bustos/okf-bundle-checker#readme",
  "bugs": {
    "url": "https://github.com/ivan-bustos/okf-bundle-checker/issues"
  },
  "keywords": [
    "okf",
    "open-knowledge-format",
    "knowledge-base",
    "markdown",
    "yaml",
    "validator",
    "cli",
    "ci"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
