{
  "name": "okf-bundle-checker-development",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Development-only offline OKF compliance checker",
  "engines": {"node": ">=22.0.0"},
  "bin": {"okf-checker-dev": "dist/cli.js"},
  "exports": "./dist/index.js",
  "files": ["dist", "docs", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "node scripts/package-smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run smoke"
  },
  "dependencies": {"remark-gfm":"4.0.1","remark-parse":"11.0.0","unified":"11.0.5","yaml":"2.9.1"},
  "devDependencies": {"@types/node":"24.19.1","typescript":"5.9.3"}
}
